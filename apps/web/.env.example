# Auth — choose ONE mode:
#
# Dev without login (pass-through to the ledger):
#   VITE_AUTH_BYPASS=true
#
# Real Supabase Auth (login screen, sessions, logout):
#   VITE_AUTH_BYPASS=false
#   VITE_SUPABASE_URL=https://<project>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<publishable anon key>
#
# Fail closed: with VITE_AUTH_BYPASS unset/false and missing Supabase
# credentials the app shows a misconfig screen instead of silently
# entering the ledger. VITE_AUTH_BYPASS is ignored in production builds
# (import.meta.env.DEV guard) — bypass only works in dev.

VITE_AUTH_BYPASS=false

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
