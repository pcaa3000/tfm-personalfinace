DATABASE_URL="postgresql://tfm:tfm-local-dev@localhost:5432/personal_finance?schema=public"
PORT=3000

# dev: trusts the x-dev-user header (local development only)
# oidc: validates Authorization Bearer JWT against a remote JWKS
AUTH_MODE=dev

# Required when AUTH_MODE=oidc. Supabase Auth example:
# OIDC_ISSUER="https://<project-ref>.supabase.co/auth/v1"
# OIDC_JWKS_URI="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
# OIDC_AUDIENCE="authenticated"
